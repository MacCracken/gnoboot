# gnoboot benchmarks
#
# gnoboot declares only `fnptr` in [deps].stdlib so the freestanding UEFI
# build (src/main.cyr -> BOOTX64.EFI) stays free of Linux-syscall stdlib.
# This harness therefore includes what IT needs explicitly. lib/bench.cyr
# has NO includes of its own — its header states the requirement and leaves
# it to the consumer (string, fmt, alloc, syscalls); vec.cyr is fmt.cyr's
# unstated peer (its %-arg path calls vec_get).
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/bench.cyr"

# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize the clock read, whose real
# cost is CALIBRATED at runtime (bench_clock_overhead_ns) and spans 230x across
# the release-gate hosts — see lib/bench.cyr's header.

fn bench_noop(): i64 { return 0; }

fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);
    return 0;
}

var r = main();
sys_exit_group(r);
