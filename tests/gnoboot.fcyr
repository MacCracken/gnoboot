# gnoboot fuzz harness
#
# gnoboot declares only `fnptr` in [deps].stdlib so the freestanding UEFI
# build (src/main.cyr -> BOOTX64.EFI) stays free of Linux-syscall stdlib.
# This harness therefore includes what IT needs explicitly (println/strlen
# live in string.cyr, not io.cyr); vec.cyr is fmt.cyr's unstated peer.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"

fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
sys_exit_group(r);
