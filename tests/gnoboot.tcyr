# gnoboot test suite
#
# gnoboot declares only `fnptr` in [deps].stdlib so the freestanding UEFI
# build (src/main.cyr -> BOOTX64.EFI) stays free of Linux-syscall stdlib.
# This harness therefore includes what IT needs explicitly; assert.cyr
# transitively pulls string/fmt/alloc/syscalls, and vec.cyr is fmt.cyr's
# unstated peer (its %-arg path calls vec_get).
include "lib/vec.cyr"
include "lib/assert.cyr"

fn main() {
    alloc_init();
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit
# 0 and score PASS. Any failure at all is exit 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
