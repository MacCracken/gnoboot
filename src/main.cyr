# gnoboot — Sovereign UEFI bootloader for AGNOS.
#
# Step 7 — POINT OF NO RETURN. Build the sovereign boot-info struct,
# call ExitBootServices, jump to kernel entry at 0x1000A8 with
# RDI = &boot_info. After EBS, gnoboot's console is gone; if we
# print anything else it's via the kernel's own UART init at
# port 0x3F8 (see agnos/kernel/arch/x86_64/boot_shim.cyr).
#
# Pairs with agnos 1.30.0 (kernel ABI break: sovereign-struct entry
# contract — `RDI = &boot_info` with magic 0x41474E4F='AGNO'). See
# agnos/CHANGELOG.md [1.30.0] for the kernel-side change, and
# agnosticos/docs/development/path-c-sovereign-uefi.md § Handoff for
# the struct spec.
#
# Build:   CYRIUS_TARGET_EFI=1 cyrius build src/main.cyr build/BOOTX64.EFI
# Smoke:   tests/ovmf_smoke.sh   expects "AGNOS kernel v" (from kernel itself)

kernel;

include "lib/fnptr.cyr"

# === UTF-16LE strings ====================================================

# "gnoboot v0.7.1: handing off to kernel\r\n\0" — 39 CHAR16 = 78 bytes; N=10 → 80.
# Version string is hand-synced with `VERSION` + `cyrius.cyml` at every
# release tag; see CLAUDE.md § Release Checklist. The OVMF smoke test's
# default EXPECT matches the literal "gnoboot v<VERSION>" prefix here.
var msg_pre[10] = {
    0x67,0x00, 0x6E,0x00, 0x6F,0x00, 0x62,0x00,    # gnob
    0x6F,0x00, 0x6F,0x00, 0x74,0x00, 0x20,0x00,    # 'oot '
    0x76,0x00, 0x30,0x00, 0x2E,0x00, 0x37,0x00,    # 'v0.7'
    0x2E,0x00, 0x31,0x00, 0x3A,0x00, 0x20,0x00,    # '.1: '
    0x68,0x00, 0x61,0x00, 0x6E,0x00, 0x64,0x00,    # hand
    0x69,0x00, 0x6E,0x00, 0x67,0x00, 0x20,0x00,    # 'ing '
    0x6F,0x00, 0x66,0x00, 0x66,0x00, 0x20,0x00,    # 'off '
    0x74,0x00, 0x6F,0x00, 0x20,0x00, 0x6B,0x00,    # 'to k'
    0x65,0x00, 0x72,0x00, 0x6E,0x00, 0x65,0x00,    # erne
    0x6C,0x00, 0x0D,0x00, 0x0A,0x00, 0x00,0x00     # 'l\r\n' + null pad
};

# Failure template: "gnoboot: fail @ XXXX\r\n\0\0" — 24 CHAR16 = 48 bytes; N=6.
# The 4-char placeholder at byte offset 32 (slot 4) is patched in place
# by efi_fail() before each print, so all 13 failure sites share one
# buffer and one print path instead of 13 standalone UTF-16LE strings.
var msg_fail[6] = {
    0x67,0x00, 0x6E,0x00, 0x6F,0x00, 0x62,0x00,    # gnob
    0x6F,0x00, 0x6F,0x00, 0x74,0x00, 0x3A,0x00,    # 'oot:'
    0x20,0x00, 0x66,0x00, 0x61,0x00, 0x69,0x00,    # ' fai'
    0x6C,0x00, 0x20,0x00, 0x40,0x00, 0x20,0x00,    # 'l @ '
    0x20,0x00, 0x20,0x00, 0x20,0x00, 0x20,0x00,    # 'XXXX' (patched per call)
    0x0D,0x00, 0x0A,0x00, 0x00,0x00, 0x00,0x00     # \r\n + null pad
};

# Per-stage 4-char UTF-16LE codes (8 bytes = one u64). Copied into
# msg_fail's placeholder by efi_fail() via a single 64-bit store. Codes
# are space-padded right so the printed line is always 4 chars wide.
var code_li [1] = { 0x4C,0x00, 0x49,0x00, 0x20,0x00, 0x20,0x00 };    # "LI  "  HandleProtocol(LoadedImage)
var code_sfs[1] = { 0x53,0x00, 0x46,0x00, 0x53,0x00, 0x20,0x00 };    # "SFS "  HandleProtocol(SimpleFileSystem)
var code_vol[1] = { 0x56,0x00, 0x4F,0x00, 0x4C,0x00, 0x20,0x00 };    # "VOL "  OpenVolume
var code_opn[1] = { 0x4F,0x00, 0x50,0x00, 0x4E,0x00, 0x20,0x00 };    # "OPN "  Open(\boot\agnos)
var code_rd [1] = { 0x52,0x00, 0x44,0x00, 0x20,0x00, 0x20,0x00 };    # "RD  "  file Read
var code_elf[1] = { 0x45,0x00, 0x4C,0x00, 0x46,0x00, 0x20,0x00 };    # "ELF "  ELF identity reject (magic / class / data / type / machine)
var code_sp [1] = { 0x53,0x00, 0x50,0x00, 0x20,0x00, 0x20,0x00 };    # "SP  "  SetPosition
var code_pt [1] = { 0x50,0x00, 0x54,0x00, 0x20,0x00, 0x20,0x00 };    # "PT  "  no PT_LOAD segment in the program-header table
# v0.7.0 hardening codes (audit 2026-08-29 F1/F3/F4). Distinct codes matter
# disproportionately here: iron has no serial cable, so this 4-char string is
# the ENTIRE diagnostic channel for a kernel that won't load.
var code_gi [1] = { 0x47,0x00, 0x49,0x00, 0x20,0x00, 0x20,0x00 };    # "GI  "  GetInfo(\boot\agnos) — cannot size the file
var code_phn[1] = { 0x50,0x00, 0x48,0x00, 0x4E,0x00, 0x20,0x00 };    # "PHN "  e_phoff / e_phnum / e_phentsize out of range
var code_sz [1] = { 0x53,0x00, 0x5A,0x00, 0x20,0x00, 0x20,0x00 };    # "SZ  "  segment bounds reject (filesz>memsz, past EOF, over cap, misaligned)
var code_shr[1] = { 0x53,0x00, 0x48,0x00, 0x52,0x00, 0x20,0x00 };    # "SHR "  short read — firmware transferred fewer bytes than asked
var code_ap [1] = { 0x41,0x00, 0x50,0x00, 0x20,0x00, 0x20,0x00 };    # "AP  "  AllocatePages
var code_ld [1] = { 0x4C,0x00, 0x44,0x00, 0x20,0x00, 0x20,0x00 };    # "LD  "  segment Read
var code_vfy[1] = { 0x56,0x00, 0x46,0x00, 0x59,0x00, 0x20,0x00 };    # "VFY "  post-load ELF magic re-check
var code_mm [1] = { 0x4D,0x00, 0x4D,0x00, 0x20,0x00, 0x20,0x00 };    # "MM  "  GetMemoryMap
var code_ebs[1] = { 0x45,0x00, 0x42,0x00, 0x53,0x00, 0x20,0x00 };    # "EBS "  ExitBootServices

# Path: UTF-16LE "\boot\agnos\0" — 12 CHAR16 = 24 bytes; N=3 → 24
var path[3] = {
    0x5C,0x00,
    0x62,0x00, 0x6F,0x00, 0x6F,0x00, 0x74,0x00,
    0x5C,0x00,
    0x61,0x00, 0x67,0x00, 0x6E,0x00, 0x6F,0x00, 0x73,0x00
};

# Path: UTF-16LE "\boot\initramfs\0" — 16 CHAR16 = 32 bytes; N=4.
# Format-NEUTRAL by design: gnoboot loads raw bytes and reports phys+size;
# the kernel owns the initramfs format (sovereign INDR today — NOT a Linux
# cpio.gz, per the kernel-grows-per-native-workload principle). Keeping the
# format out of the gnoboot-visible name lets it evolve without re-cutting
# the loader. Optional: absent → initramfs_phys/size stay 0, boot proceeds
# (writable .img boots carry no initramfs). See agnosticos roadmap v0.5.0 +
# iso-stage4-plan § N1b.
var path_initramfs[4] = {
    0x5C,0x00,
    0x62,0x00, 0x6F,0x00, 0x6F,0x00, 0x74,0x00,
    0x5C,0x00,
    0x69,0x00, 0x6E,0x00, 0x69,0x00, 0x74,0x00, 0x72,0x00,
    0x61,0x00, 0x6D,0x00, 0x66,0x00, 0x73,0x00,
    0x00,0x00
};

# Path: UTF-16LE "\boot\cmdline\0" — 14 CHAR16 = 28 bytes; N=4 (pad to 32).
# Optional ESP file (NUL-terminated UTF-8 kernel cmdline). Absent →
# cmdline_phys stays 0 (forward-compat: no kernel consumer yet).
var path_cmdline[4] = {
    0x5C,0x00,
    0x62,0x00, 0x6F,0x00, 0x6F,0x00, 0x74,0x00,
    0x5C,0x00,
    0x63,0x00, 0x6D,0x00, 0x64,0x00, 0x6C,0x00, 0x69,0x00, 0x6E,0x00, 0x65,0x00,
    0x00,0x00,
    0x00,0x00, 0x00,0x00
};

# === Protocol GUIDs ======================================================

var li_guid[2] = {
    0xA1,0x31,0x1B,0x5B, 0x62,0x95, 0xD2,0x11,
    0x8E,0x3F,0x00,0xA0,0xC9,0x69,0x72,0x3B
};

var sfs_guid[2] = {
    0x22,0x5B,0x4E,0x96, 0x59,0x64, 0xD2,0x11,
    0x8E,0x39,0x00,0xA0,0xC9,0x69,0x72,0x3B
};

# EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID = 9042a9de-23dc-4a38-96fb-7aded080516a.
# Captured pre-EBS so the kernel can paint a boot-time canary at entry
# instruction #1: boot_info-inlined fb fields let raw asm in agnos
# boot_shim read fb_phys from [rdi+0x48] without walking a tag stream.
var gop_guid[2] = {
    0xDE,0xA9,0x42,0x90, 0xDC,0x23, 0x38,0x4A,
    0x96,0xFB,0x7A,0xDE,0xD0,0x80,0x51,0x6A
};

# EFI_FILE_INFO_ID = 09576e92-6d3f-11d2-8e39-00a0c969723b. Passed to
# EFI_FILE_PROTOCOL.GetInfo (file+0x40) to read FileSize (u64) at
# EFI_FILE_INFO+0x08 before AllocatePages — used by load_esp_blob to
# size the optional initramfs / cmdline reads (v0.5.0).
var file_info_guid[2] = {
    0x92,0x6E,0x57,0x09, 0x3F,0x6D, 0xD2,0x11,
    0x8E,0x39,0x00,0xA0,0xC9,0x69,0x72,0x3B
};

# EFI_ACPI_20_TABLE_GUID = 8868e871-e4f1-11d3-bc22-0080c73c8881 (preferred).
# EFI_ACPI_TABLE_GUID (1.0) = eb9d2d30-2d88-11d3-9a16-0090273fc14d (fallback).
# Matched against each EFI_CONFIGURATION_TABLE.VendorGuid; VendorTable IS
# the RSDP physical address → boot_info->acpi_rsdp_phys (v0.5.0).
var acpi20_guid[2] = {
    0x71,0xE8,0x68,0x88, 0xF1,0xE4, 0xD3,0x11,
    0xBC,0x22,0x00,0x80,0xC7,0x3C,0x88,0x81
};
var acpi10_guid[2] = {
    0x30,0x2D,0x9D,0xEB, 0x88,0x2D, 0xD3,0x11,
    0x9A,0x16,0x00,0x90,0x27,0x3F,0xC1,0x4D
};

# === Sovereign boot-info struct ==========================================
# Layout per agnosticos/docs/development/path-c-sovereign-uefi.md § Handoff.
# 120 bytes total (112 inlined fields + 8-byte END tag).
#
# Layout version 2 (v0.1.0+ canary build) — bumped from v1 to inline the
# framebuffer fields at 0x48-0x60. Originally framebuffer was a type=1
# tag in the tag stream; but the agnos kernel canary needs to read
# fb_phys from raw asm at entry instruction #1 (before stack setup,
# before any cyrius fn call), and walking a tag stream in raw asm is
# brutal. Inlining at known offsets makes the canary 26 bytes total.
#
#   0x00  u32   magic            = 0x41474E4F ('AGNO')
#   0x04  u32   version          = 2 (bumped: inlined fb fields)
#   0x08  u32   struct_size      = 128 (0x80) — was 120 (0x78) before v0.7.1.
#                                  A u32. Reading it as a u64 also captures
#                                  `flags` and yields struct_size|(flags<<32);
#                                  see handoff-protocol.md § 2 + erratum E2.
#   0x0C  u32   flags            (bit 0=serial, bit 1=fb_present,
#                                  bit 2=kaslr_no_entropy — v0.7.0: RDRAND
#                                  failed, so kernel_base at 0x70 is the
#                                  DETERMINISTIC fallback, not a slide.
#                                  Set with read-modify-write OR, never a
#                                  bare store: the bits are independent.)
#   0x10  u64   initramfs_phys   (v0.5.0: \boot\initramfs base; 0 if absent)
#   0x18  u64   initramfs_size   (v0.5.0: initramfs byte count; 0 if absent)
#   0x20  u64   cmdline_phys     (v0.5.0: \boot\cmdline base; 0 if absent)
#   0x28  u64   memmap_phys      (filled at runtime: &mm_buf)
#   0x30  u32   memmap_count     (filled at runtime: mm_size / mm_dsz)
#   0x34  u32   memmap_entsize   (filled at runtime: mm_dsz)
#   0x38  u64   acpi_rsdp_phys   (v0.5.0: RSDP from EFI cfg table; 0 if absent)
#   0x40  u64   efi_st_phys      (filled at runtime: SystemTable*)
#   0x48  u64   fb_phys          (filled if GOP located; 0 = no fb)
#   0x50  u32   fb_pitch         (bytes per scanline = ppl * 4)
#   0x54  u32   fb_width         (HorizontalResolution)
#   0x58  u32   fb_height        (VerticalResolution)
#   0x5C  u32   fb_pixel_format  (0=RGB, 1=BGR, 2=Bitmask, 3=BltOnly)
#   0x60  u32   fb_mode_current  (GOP Mode->Mode    — which mode is live)
#   0x64  u32   fb_mode_max      (GOP Mode->MaxMode — how many modes exist)
#   0x68  u64   fb_size          (GOP Mode->FrameBufferSize — UEFI 2.10
#                                 §11.9.1 authoritative FB extent;
#                                 kernel uses this for WC remap range
#                                 in preference to pitch*height when
#                                 non-zero. Occupies 0x68-0x6F IN FULL.)
#   0x78  u32   fb_mode_chosen   (0.6.1, RELOCATED from 0x6C at v0.7.1 — the
#                                 mode gnoboot SELECTED. Equal to
#                                 fb_mode_current when no larger RGB/BGR mode
#                                 existed; differs when native-res selection
#                                 fired. Lets a burn distinguish "nothing
#                                 better offered" from "SetMode refused".)
#
# ⚠ 0x6C IS NOT A FIELD. It is the upper half of fb_size and must not be read.
# From v0.6.1 to v0.7.0 fb_mode_chosen was declared there, overlapping fb_size's
# u64 — and because the 0x6C store ran BEFORE the 0x68 store, the u64 landed
# last and destroyed it on every boot. The field read as the high 32 bits of
# FrameBufferSize, i.e. 0 for any framebuffer under 4 GB, i.e. always 0. Found
# while drafting docs/standards/handoff-protocol.md (erratum E1).
#
# Reordering the two stores was NOT an available fix: putting best_mode in
# fb_size's upper half makes agnos's load64(bi+0x68) report a multi-gigabyte
# framebuffer and hand that extent to its WC remap. The fields had to be
# separated, so the struct grew 120 -> 128 bytes. Append-only per the spec's
# § 6: every pre-existing field keeps its offset and type, `version` stays 2,
# and struct_size carries the change. agnos's boot_info_copy is already 128
# bytes and takes min(struct_size, 128), so it accommodates this exactly.
#   0x70  u64   kernel_base      (v0.6.0: the load base actually chosen —
#                                 the KASLR slide for ET_DYN, or min p_paddr
#                                 for ET_EXEC. Read with flags bit 2 to know
#                                 whether it was randomized or fell back.)
#
# ⚠ THERE IS NO TAG STREAM AND NO END TERMINATOR — this is a FLAT 120-byte
# struct. Until v0.6.0 the last 8 bytes were documented (and zero-filled) as a
# type=0 END tag; the v0.6.0 kernel_base store at 0x70 overwrote it, so a
# consumer walking tags from 0x70 would read type=low32(kernel_base) with
# size=0 and spin or run off the end. Nothing shipped walks tags — agnos reads
# fixed offsets only — but the comment claimed a terminator that had not
# existed for two releases (audit 2026-08-29 finding F5). Recorded here as
# fact; the *decision* about whether boot_info ever grows a real tag stream
# belongs to the M4 handoff-protocol spec, which is blocked on exactly this.
# Every field above is at a FIXED offset. struct_size (0x08) = 128 = the whole
# thing. Do not add a walker. The authoritative contract is
# docs/standards/handoff-protocol.md — this comment is a mirror of it, not a
# second source of truth.
#
# fb_mode_current + fb_mode_max overlay the previously-reserved u64 at
# 0x60. Reserved-slot overlay (not a version bump) because v2 readers
# ignored those 8 bytes; new readers can use them to tell which GOP
# mode the firmware booted with — primary diagnostic signal for
# quiet-boot vs VGA-spec scanout divergence on AMD Zen.
#
# fb_size at 0x68. Wire version stays 2 because no consumer walks the
# tag stream (agnos kernel reads inlined fields at fixed offsets only);
# the END-tag relocation from 0x68 → 0x70 is invisible to fixed-offset
# readers. Kernels reading load64(boot_info+0x68) under a gnoboot that
# doesn't populate the slot get 0, which the kernel's
# fb_size_or_fallback() handles by falling back to pitch*height.
var boot_info[16] = {
    # 0x00: magic = 0x41474E4F LE
    0x4F, 0x4E, 0x47, 0x41,
    # 0x04: version = 2 — UNCHANGED by the v0.7.1 growth: an append moves no
    # existing field, so a v2 fixed-offset reader is unaffected (spec § 6).
    0x02, 0x00, 0x00, 0x00,
    # 0x08: struct_size = 128 (0x80), was 120 (0x78) through v0.7.0
    0x80, 0x00, 0x00, 0x00,
    # 0x0C: flags = 0 (fb_present bit set at runtime if GOP captured;
    #       everything else zero via trailing-zero fill; fb_size at 0x68
    #       filled at runtime alongside the other fb fields; END tag at
    #       0x70 is type=0 because trailing zeros put 0 there too)
    0x00, 0x00, 0x00, 0x00
};

# RDRAND entropy for KASLR (agnos 1.47.3). Retries up to 10x on CF=0 per Intel's
# DRNG guidance, then gives up and reports the failure through g_rdrand_fail.
#
# v0.7.0 (audit 2026-08-29 finding F6). The previous version issued ONE `rdrand`
# and ignored CF. On failure rcx is architecturally 0, and because efi_main's
# 16x re-roll loop calls this same failing instruction every time, all 16 rolls
# returned the SAME value — so the kernel loaded at a fixed 32 MB and reported a
# kernel_base that is a perfectly legal slide value. KASLR failed OPEN and
# SILENTLY: benign for booting, total for the security property, and
# indistinguishable at the kernel from a successful randomization. The retry
# makes exhaustion vanishingly unlikely; g_rdrand_fail makes it VISIBLE when it
# happens (→ boot_info flags bit 2), which is the part that actually matters.
#
# Register note: this fn contains inline asm, so cyrius skips register
# allocation for it — the `var pout = &out;` lea-into-rax idiom is what keeps
# rax live across the block. r8 is the retry counter: caller-saved in both
# SysV and MS x64, and untouched by this fn's own prologue/epilogue.
# Re-verify by disassembly after any toolchain bump (see state.md § Source).
fn rdrand_u64() {
    var out = 0;
    var pout = &out;                    # rax = &out (gnoboot's lea-into-rax idiom)
    asm {
        0x49; 0xC7; 0xC0; 0x0A; 0x00; 0x00; 0x00;   # mov r8, 10        (attempts)
        0x48; 0x0F; 0xC7; 0xF1;                     # retry: rdrand rcx
        0x72; 0x08;                                 # jc done           (CF=1 → rcx valid)
        0x49; 0xFF; 0xC8;                           # dec r8
        0x75; 0xF5;                                 # jnz retry
        0x48; 0x31; 0xC9;                           # xor rcx, rcx      (exhausted → 0)
        0x48; 0x89; 0x08;                           # done: mov [rax], rcx
    }
    if (out == 0) { store64(&g_rdrand_fail, 1); }   # 10x CF=0, or a true 0 draw
    return out;
}

# === OUT slots + parse buffers ============================================

var li_out[1];
var sfs_out[1];
var root_out[1];
var file_out[1];
var gop_out[1];
var read_sz[1];
var alloc_addr[1];
var elf_hdr[8];
# v0.7.0: the whole program-header table is read once into memory and iterated
# there, instead of the old single 56-byte phdr read. Two reasons: it removes a
# second SetPosition/Read round trip per segment, and it means the file-bounds
# check happens ONCE, before any header field is trusted. 16 x 56 = 896 bytes;
# PH_MAX=16 is enforced at parse time, so this buffer cannot be overrun.
var phdrs[112];
var kfile_sz[1];          # \boot\agnos size from GetInfo — the bound for every p_offset/p_filesz
var g_rdrand_fail[1];     # set by rdrand_u64 when RDRAND gave up → boot_info flags bit 2
var mm_buf[2048];
var mm_size[1];
var mm_key[1];
var mm_dsz[1];
var mm_dver[1];

# --- v0.5.0 optional-fill scratch (initramfs / cmdline blob loader) ------
# module-global so the [N] = N*u64 unit applies: finfo[32] = 256 bytes.
var blob_file_out[1];     # EFI_FILE_PROTOCOL* handle for the opened blob
var finfo[32];            # EFI_FILE_INFO scratch (256 B; FileSize @ +0x08)
var finfo_sz[1];          # GetInfo BufferSize in/out
var blob_addr[1];         # AllocatePages address in/out
var blob_rdsz[1];         # Read BufferSize in/out
var initramfs_size_v[1];  # receives initramfs byte count
var cmdline_size_v[1];    # receives cmdline byte count (size unused, phys only)
# efi_main stashes these so load_esp_blob stays a 2-param helper (matches
# the efi_print/efi_clear/efi_fail convention — no >2-param fn in this file).
var g_root[1];            # OpenVolume root EFI_FILE_PROTOCOL*
var g_fn_open[1];         # root->Open fn ptr
var g_fn_alloc[1];        # BootServices->AllocatePages fn ptr


# === Helpers ============================================================

fn efi_print(st, msg): i64 {
    var con_out = load64(st + 0x40);
    var out_str = load64(con_out + 0x08);
    return fncall2(out_str, con_out, msg);
}

# Call EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL.ClearScreen on ConOut. Wipes the
# firmware splash + any prior text-mode output and homes the cursor to
# (0, 0). Used right before msg_pre so gnoboot's handoff line appears
# on a clean screen instead of after the OVMF / firmware preamble.
# ClearScreen lives at offset 0x30 in the SimpleTextOutput protocol.
fn efi_clear(st): i64 {
    var con_out  = load64(st + 0x40);
    var fn_clear = load64(con_out + 0x30);
    return fncall1(fn_clear, con_out);
}

# Patch msg_fail's 4-char placeholder (bytes 32..40) with the code at
# `code` and print. Returns 0 so callers can chain into `return 0;`
# cleanly after the call.
fn efi_fail(st, code): i64 {
    store64(&msg_fail + 32, load64(code));
    efi_print(st, &msg_fail);
    return 0;
}

# Load an OPTIONAL ESP file into a fresh EfiLoaderData region and report
# its byte length through size_out. Returns the physical base on success,
# or 0 on ANY failure (file absent, GetInfo / AllocatePages / Read error)
# — the caller then leaves the matching boot_info field at 0, exactly like
# the GOP-absent path. Optional-and-benign is MANDATORY: a normal AGNOS
# boot (writable .img with no initramfs / cmdline on the ESP) must not
# regress, so this never calls efi_fail / aborts.
#
# Reads g_root / g_fn_open / g_fn_alloc (stashed by efi_main) to stay a
# 2-param fn, matching this file's helper convention.
#   EFI_FILE_PROTOCOL: Read @ +0x20, SetPosition @ +0x38, GetInfo @ +0x40.
#   EFI_FILE_INFO:     FileSize (u64) @ +0x08.
#   AllocatePages:     AllocateAnyPages=0, EfiLoaderData=2 (pure data,
#                      never executed → NX-safe; survives ExitBootServices
#                      per UEFI 2.10 §2.3.2; convergent with systemd-boot /
#                      GRUB-EFI / Limine initrd allocation).
# Runs pre-EBS and BEFORE the Step-11/12 GetMemoryMap pair, so the blob's
# EfiLoaderData region appears in the memory map the kernel inherits.
fn load_esp_blob(path_ptr, size_out): i64 {
    store64(size_out, 0);

    var rt  = load64(&g_root);
    var fno = load64(&g_fn_open);
    var rc  = fncall5(fno, rt, &blob_file_out, path_ptr, 1, 0);
    if (rc != 0) { return 0; }                       # absent → benign
    var fh  = load64(&blob_file_out);
    var fn_gi  = load64(fh + 0x40);                  # GetInfo
    var fn_brd = load64(fh + 0x20);                  # Read
    var fn_bsp = load64(fh + 0x38);                  # SetPosition

    store64(&finfo_sz, 256);
    rc = fncall4(fn_gi, fh, &file_info_guid, &finfo_sz, &finfo);
    if (rc != 0) { return 0; }
    var fsize = load64(&finfo + 0x08);
    if (fsize == 0) { return 0; }                    # empty → nothing to load
    # Sanity cap (1 GiB): FileSize is an unchecked firmware u64. Without
    # this, a pathological size overflows `(fsize + 0xFFF) / 0x1000` → a
    # tiny page count → AllocatePages under-allocates → the Read below
    # overruns. A boot-stage blob is never this large; reject benignly.
    if (fsize > 0x40000000) { return 0; }

    var bpages = (fsize + 0xFFF) / 0x1000;
    var fal = load64(&g_fn_alloc);
    store64(&blob_addr, 0);
    rc = fncall4(fal, 0, 2, bpages, &blob_addr);     # AnyPages, LoaderData
    if (rc != 0) { return 0; }
    var base = load64(&blob_addr);

    rc = fncall2(fn_bsp, fh, 0);                      # rewind to start
    if (rc != 0) { return 0; }
    store64(&blob_rdsz, fsize);
    rc = fncall3(fn_brd, fh, &blob_rdsz, base);
    if (rc != 0) { return 0; }
    # EFI_FILE_PROTOCOL.Read may short-read on success (UEFI 2.10 §13.5.1:
    # it rewrites BufferSize to bytes-actually-transferred). A partial read
    # would hand the kernel an inflated size over a truncated buffer — fail
    # benignly instead (the optional field stays 0). The pre-existing kernel
    # ELF load assumes a full read too, but it's iron-proven on this FAT/ESP
    # path; the guard makes the new optional path strictly safe.
    if (load64(&blob_rdsz) < fsize) { return 0; }

    # NOTE: the file handle (blob_file_out) is intentionally not Close()d —
    # all Boot Services handles are reclaimed at ExitBootServices a few
    # steps later, and the pre-existing \boot\agnos handle is likewise left
    # open. Closing here would buy nothing pre-EBS.
    store64(size_out, fsize);
    return base;
}

# Compare two 16-byte EFI_GUIDs (two u64 lanes). Returns 1 if equal, else
# 0. Byte order is irrelevant to equality — both operands are stored in
# the same in-memory GUID layout, so a lane-wise u64 compare is exact.
fn guid_eq(a, b): i64 {
    if (load64(a + 0) != load64(b + 0)) { return 0; }
    if (load64(a + 8) != load64(b + 8)) { return 0; }
    return 1;
}


# === Entry ============================================================

fn efi_main(handle, st): i64 {
    var bs        = load64(st + 0x60);
    var fn_hp     = load64(bs + 0x98);
    var fn_alloc  = load64(bs + 0x28);
    var fn_mmap   = load64(bs + 0x38);
    var fn_locate = load64(bs + 0x140);
    var fn_ebs    = load64(bs + 0xE8);

    # --- 1-2: HandleProtocol(LI) + HandleProtocol(SFS) ---
    var rc = fncall3(fn_hp, handle, &li_guid, &li_out);
    if (rc != 0) { efi_fail(st, &code_li); return 0; }
    var li  = load64(&li_out);
    var dev = load64(li + 0x18);

    rc = fncall3(fn_hp, dev, &sfs_guid, &sfs_out);
    if (rc != 0) { efi_fail(st, &code_sfs); return 0; }
    var sfs        = load64(&sfs_out);
    var fn_openvol = load64(sfs + 0x08);

    # --- 3-4: OpenVolume + Open file ---
    rc = fncall2(fn_openvol, sfs, &root_out);
    if (rc != 0) { efi_fail(st, &code_vol); return 0; }
    var root    = load64(&root_out);
    var fn_open = load64(root + 0x08);

    rc = fncall5(fn_open, root, &file_out, &path, 1, 0);
    if (rc != 0) { efi_fail(st, &code_opn); return 0; }
    var file      = load64(&file_out);
    var fn_read   = load64(file + 0x20);
    var fn_setpos = load64(file + 0x38);

    # ================================================================
    # Steps 5-10: load the kernel.  REWRITTEN AT v0.7.0 — "ELF-load
    # hardening", scoped by docs/audit/2026-08-29-audit.md (F1-F4).
    #
    # What this block used to do: check ONE byte of ELF magic, read ONE
    # program header, trust every u64 in it, and Read without checking
    # how many bytes actually arrived.  The published threat model in
    # SECURITY.md claimed "oversized program-header counts, malformed
    # PT_LOAD entries — bounds-checked at parse time"; none of that was
    # true.  It is now.
    #
    # The realistic trigger is not an attacker — anyone who can write
    # \boot\agnos can just supply a valid kernel, which SECURITY.md
    # accepts.  It is a TRUNCATED kernel: an interrupted dd, a bad USB
    # write, a failed ISO build.  Before v0.7.0 that booted into
    # whatever AllocatePages happened to return (UEFI 2.x §7.2:
    # "undefined") and triple-faulted with no console.  Now it prints a
    # 4-char code before EBS, which is the whole point of the design.
    #
    # The model for all of it is load_esp_blob(), which has done
    # GetInfo-sizing and short-read checking since v0.5.0.  The
    # *optional* initramfs path was strictly safer than the *mandatory*
    # kernel path for two releases.
    # ================================================================

    # --- 5: Size the file (audit F4) --------------------------------
    # Every offset and length parsed below is bounds-checked against
    # this.  finfo / finfo_sz are load_esp_blob's scratch globals;
    # sharing them is safe because that helper does not run until step
    # 10d and nothing between here and there reads them.  KEEP THAT
    # ORDERING if this block ever moves.
    var fn_getinfo = load64(file + 0x40);
    store64(&finfo_sz, 256);
    rc = fncall4(fn_getinfo, file, &file_info_guid, &finfo_sz, &finfo);
    if (rc != 0) { efi_fail(st, &code_gi); return 0; }
    var ksz = load64(&finfo + 0x08);
    # `< 64` is the whole check: it rejects both a file too small to hold an
    # ELF header AND a firmware-reported size with the high bit set (which
    # reads back negative as i64), so every later `ksz - x` is safe.
    if (ksz < 64) { efi_fail(st, &code_gi); return 0; }
    store64(&kfile_sz, ksz);

    # --- 6: Read + gate on the ELF64 identity (audit F1) ------------
    # This is a GATE, not a sanity check.  Everything after it trusts
    # e_phoff to drive SetPosition and the program headers to drive
    # AllocatePages and Read.  The post-load magic re-check at step 10a
    # is a backstop that fires only AFTER the allocation and the copy —
    # it cannot protect the allocation itself.
    store64(&read_sz, 64);
    rc = fncall3(fn_read, file, &read_sz, &elf_hdr);
    if (rc != 0) { efi_fail(st, &code_rd); return 0; }
    if (load64(&read_sz) < 64) { efi_fail(st, &code_shr); return 0; }

    if (load8(&elf_hdr + 0) != 0x7F) { efi_fail(st, &code_elf); return 0; }   # \x7F
    if (load8(&elf_hdr + 1) != 0x45) { efi_fail(st, &code_elf); return 0; }   # 'E'
    if (load8(&elf_hdr + 2) != 0x4C) { efi_fail(st, &code_elf); return 0; }   # 'L'
    if (load8(&elf_hdr + 3) != 0x46) { efi_fail(st, &code_elf); return 0; }   # 'F'
    if (load8(&elf_hdr + 4) != 2)    { efi_fail(st, &code_elf); return 0; }   # EI_CLASS = ELFCLASS64
    if (load8(&elf_hdr + 5) != 1)    { efi_fail(st, &code_elf); return 0; }   # EI_DATA  = ELFDATA2LSB

    # e_type is a u16 at +16.  The pre-v0.7.0 code read it with load8,
    # which happened to work little-endian for values < 256 but would
    # have accepted e.g. 0x0102 as ET_EXEC.  Read the full halfword.
    var e_type = load16(&elf_hdr + 16);
    var ty_ok = 0;
    if (e_type == 2) { ty_ok = 1; }                        # ET_EXEC — fixed kernel
    if (e_type == 3) { ty_ok = 1; }                        # ET_DYN  — PIE kernel (KASLR)
    if (ty_ok == 0) { efi_fail(st, &code_elf); return 0; }
    if (load16(&elf_hdr + 18) != 0x3E) { efi_fail(st, &code_elf); return 0; }  # EM_X86_64

    var e_entry     = load64(&elf_hdr + 24);
    var e_phoff     = load64(&elf_hdr + 0x20);
    var e_phentsize = load16(&elf_hdr + 0x36);
    var e_phnum     = load16(&elf_hdr + 0x38);

    # --- 7: Bound the program-header table, then read it whole ------
    # PH_MAX = 16.  phdrs[112] is 896 bytes = 16 x 56 exactly, so this
    # cap is what makes the buffer un-overrunnable.  REJECT rather than
    # clamp: silently looking at the first 16 of 20 headers could skip
    # a PT_LOAD and under-load the kernel, which is the failure mode
    # F2 exists to kill.
    if (e_phentsize != 56) { efi_fail(st, &code_phn); return 0; }
    if (e_phnum < 1)       { efi_fail(st, &code_phn); return 0; }
    if (e_phnum > 16)      { efi_fail(st, &code_phn); return 0; }
    if (e_phoff < 64)      { efi_fail(st, &code_phn); return 0; }  # would overlap the ELF header
    if (e_phoff > ksz)     { efi_fail(st, &code_phn); return 0; }
    var ph_bytes = e_phnum * 56;
    # Written as a subtraction, not `e_phoff + ph_bytes > ksz`: e_phoff
    # is an unchecked u64 and the addition could wrap.  e_phoff <= ksz
    # is already established, so ksz - e_phoff cannot go negative.
    if (ph_bytes > ksz - e_phoff) { efi_fail(st, &code_phn); return 0; }

    rc = fncall2(fn_setpos, file, e_phoff);
    if (rc != 0) { efi_fail(st, &code_sp); return 0; }
    store64(&read_sz, ph_bytes);
    rc = fncall3(fn_read, file, &read_sz, &phdrs);
    if (rc != 0) { efi_fail(st, &code_rd); return 0; }
    if (load64(&read_sz) < ph_bytes) { efi_fail(st, &code_shr); return 0; }

    # --- 8: Validate every PT_LOAD and measure the image (F2 + F4) --
    # Pass 1 of 2.  Nothing is allocated or copied until every segment
    # has passed, so a malformed header rejects before any firmware
    # state changes.
    #
    # k_cap = 256 MB is not arbitrary: it is the kernel's own per-proc
    # CR3 identity extent (agnos proc.cyr copies PD[0..127]), the same
    # ceiling the KASLR window is chosen under.  A kernel image that
    # does not fit below it cannot be booted by this loader anyway, so
    # rejecting here is honest rather than merely defensive — and it is
    # what makes the page arithmetic below provably wrap-free.
    var k_cap = 0x10000000;
    var nload = 0;
    var lo = 0;
    var hi = 0;
    var i = 0;
    while (i < e_phnum) {
        var ph = &phdrs + i * 56;
        if (load32(ph + 0) == 1) {                         # PT_LOAD
            var s_off = load64(ph +  8);
            var s_pa  = load64(ph + 24);
            var s_fsz = load64(ph + 32);
            var s_msz = load64(ph + 40);
            # Every one of these was unchecked before v0.7.0.
            if (s_pa  < 0)     { efi_fail(st, &code_sz); return 0; }
            if (s_pa  > k_cap) { efi_fail(st, &code_sz); return 0; }
            if (s_msz < 0)     { efi_fail(st, &code_sz); return 0; }
            if (s_msz > k_cap) { efi_fail(st, &code_sz); return 0; }
            if (s_fsz < 0)     { efi_fail(st, &code_sz); return 0; }
            # filesz > memsz is the copy-overrun case: pages are sized
            # from memsz, then filesz bytes get Read into them.
            if (s_fsz > s_msz) { efi_fail(st, &code_sz); return 0; }
            if (s_off < 0)     { efi_fail(st, &code_sz); return 0; }
            if (s_off > ksz)   { efi_fail(st, &code_sz); return 0; }
            if (s_fsz > ksz - s_off) { efi_fail(st, &code_sz); return 0; }   # segment runs past EOF
            if (s_msz > 0) {
                var s_end = s_pa + s_msz;                  # both bounded by k_cap — cannot wrap
                if (nload == 0) { lo = s_pa; hi = s_end; }
                if (s_pa  < lo) { lo = s_pa; }
                if (s_end > hi) { hi = s_end; }
                nload = nload + 1;
            }
        }
        i = i + 1;
    }
    if (nload == 0) { efi_fail(st, &code_pt); return 0; }

    # One contiguous allocation spanning every PT_LOAD, so the relative
    # offsets between segments survive a KASLR slide unchanged.
    var lo_pg = lo - (lo % 0x1000);
    var span  = hi - lo_pg;
    if (span > k_cap) { efi_fail(st, &code_sz); return 0; }
    var pages = (span + 0xFFF) / 0x1000;                   # span <= 256 MB — no wrap

    # --- 9: Allocate ------------------------------------------------
    # MemoryType arg = 1 (EfiLoaderCode), NOT 2 (EfiLoaderData). Modern
    # AMD UEFI firmware may NX-mark LoaderData pages under strict W^X
    # — jumping into a LoaderData page triple-faults silently on iron
    # while OVMF (lenient W^X for data execution) lets it run.
    # LoaderCode signals "this is executable" and firmware leaves NX
    # clear in the live page tables we inherit post-EBS.
    var load_base = lo_pg;
    var kernel_jump_target = e_entry;
    if (e_type == 3) {
        # KASLR: the PIE kernel links at base 0, so slide the whole span
        # to an RDRAND-chosen, 2 MB-aligned base in [32 MB, 254 MB):
        # above the kernel's fixed 0..18 MB scratch + 16 MB PMM ceiling,
        # and below the 256 MB per-proc-CR3 identity extent. 111 slots
        # ~ 6.8 bits of slide. If the firmware has a base reserved,
        # re-roll up to 16x, then fall back to the fixed 0x100000
        # (still correct — the kernel is RIP-relative).
        var ksl_ok = 0;
        var ksl_try = 0;
        while (ksl_try < 16) {
            # Audit F7: MASK the sign bit, do not negate. `0 - x` is the
            # identity on i64::MIN, so the old `if (r < 0) r = 0 - r;`
            # left it negative, and cyrius `%` is C-truncated — the
            # slide would have landed BELOW the 32 MB floor. Verified
            # empirically against the pinned toolchain, not assumed.
            var ksl_r = rdrand_u64() & 0x7FFFFFFFFFFFFFFF;
            load_base = 0x2000000 + (ksl_r % 111) * 0x200000;
            store64(&alloc_addr, load_base);
            if (fncall4(fn_alloc, 2, 1, pages, &alloc_addr) == 0) { ksl_ok = 1; ksl_try = 16; }
            else { ksl_try = ksl_try + 1; }
        }
        if (ksl_ok == 0) {
            load_base = 0x100000;
            store64(&alloc_addr, load_base);
            if (fncall4(fn_alloc, 2, 1, pages, &alloc_addr) != 0) { efi_fail(st, &code_ap); return 0; }
        }
        kernel_jump_target = load_base + (e_entry - lo_pg);  # PIE: entry slides with the base
    } else {
        # ET_EXEC: the image declares where it lives. AllocatePages with
        # AllocateAddress is what enforces that the range is actually
        # free — gnoboot delegates that check to the firmware rather
        # than duplicating its allocator state (audit F5-adjacent; a
        # non-free range returns non-zero and we fail clean at "AP").
        store64(&alloc_addr, load_base);
        rc = fncall4(fn_alloc, 2, 1, pages, &alloc_addr);
        if (rc != 0) { efi_fail(st, &code_ap); return 0; }
    }

    # Expose the chosen base at boot_info+0x70 (the kernel reports it as
    # the `KASLR: kernel_base` slide probe), and — new at v0.7.0 — say
    # out loud when it is NOT randomized. RDRAND failing used to leave a
    # fixed 32 MB base that looked exactly like a successful slide.
    store64(&boot_info + 0x70, load_base);
    if (load64(&g_rdrand_fail) != 0) {
        store32(&boot_info + 0x0C, load32(&boot_info + 0x0C) | 0x04);   # flags.kaslr_no_entropy
    }

    # --- 10: Copy each PT_LOAD into place, zero each BSS gap --------
    # Pass 2 of 2. Every segment, not just the first — that is the M5
    # work, and it is a correctness fix rather than a feature: a kernel
    # linked with a separate RX-text / RW-data split used to be
    # SILENTLY under-loaded (only phdr[0] was ever read), and a kernel
    # whose first program header was PT_PHDR failed outright at "PT".
    var hdr_dst = 0;
    var hdr_seen = 0;
    i = 0;
    while (i < e_phnum) {
        var ph2 = &phdrs + i * 56;
        if (load32(ph2 + 0) == 1) {
            var d_msz = load64(ph2 + 40);
            if (d_msz > 0) {
                var d_off = load64(ph2 +  8);
                var d_pa  = load64(ph2 + 24);
                var d_fsz = load64(ph2 + 32);
                var dst   = load_base + (d_pa - lo_pg);
                if (d_fsz > 0) {
                    rc = fncall2(fn_setpos, file, d_off);
                    if (rc != 0) { efi_fail(st, &code_sp); return 0; }
                    store64(&read_sz, d_fsz);
                    rc = fncall3(fn_read, file, &read_sz, dst);
                    if (rc != 0) { efi_fail(st, &code_ld); return 0; }
                    # Audit F3. UEFI 2.10 §13.5.1: Read rewrites
                    # BufferSize to bytes ACTUALLY transferred and still
                    # returns EFI_SUCCESS. Without this a truncated
                    # kernel loaded "successfully" and the unread tail
                    # kept whatever AllocatePages returned — undefined
                    # per UEFI 2.x §7.2 — and gnoboot jumped into it.
                    if (load64(&read_sz) < d_fsz) { efi_fail(st, &code_shr); return 0; }
                    if (d_off == 0) { if (d_fsz > 3) { hdr_dst = dst; hdr_seen = 1; } }
                }
                # Zero [filesz, memsz). ELF semantics require it and
                # AllocatePages does NOT guarantee zeroed memory (UEFI
                # 2.x §7.2). QEMU OVMF tends to hand back zeroes, which
                # masked this through Step 7; real firmware leaves POST
                # scratch there and kernel .bss globals read garbage.
                # Byte loop: microseconds at ~64 KB, and gnoboot keeps
                # zero stdlib deps so there is no memset to call.
                var bss_i = dst + d_fsz;
                var bss_e = dst + d_msz;
                while (bss_i < bss_e) {
                    store8(bss_i, 0);
                    bss_i = bss_i + 1;
                }
            }
        }
        i = i + 1;
    }

    # --- 10a: Post-load re-verify (M7's defensive re-check) ---------
    # Only meaningful if some PT_LOAD actually covers file offset 0, so
    # that the ELF header is part of the loaded image. Conditional
    # rather than assumed: the pre-v0.7.0 code checked unconditionally
    # at p_paddr, which is only the header's address when the single
    # segment happens to start at file offset 0.
    if (hdr_seen == 1) {
        if (load8(hdr_dst + 0) != 0x7F) { efi_fail(st, &code_vfy); return 0; }
        if (load8(hdr_dst + 1) != 0x45) { efi_fail(st, &code_vfy); return 0; }
        if (load8(hdr_dst + 2) != 0x4C) { efi_fail(st, &code_vfy); return 0; }
        if (load8(hdr_dst + 3) != 0x46) { efi_fail(st, &code_vfy); return 0; }
    }

    # --- 10c: Locate GOP and capture framebuffer mode into boot_info ---
    # MUST run pre-EBS (LocateProtocol is a Boot Service). MUST run
    # before the Step-12 GetMemoryMap-immediately-before-EBS pattern,
    # because any firmware call after GetMemoryMap invalidates the map
    # key. Slotted between BSS zero and Step 11.
    #
    # Failure mode is benign: if GOP isn't present (text-mode firmware,
    # headless serial-only board) LocateProtocol returns non-zero and
    # we leave fb_phys = 0 in boot_info. The agnos canary checks
    # fb_phys for null and skips the paint if absent — kernel still
    # boots, just no visual signal.
    #
    # Fields copied (not pointers) because EFI_GRAPHICS_OUTPUT_PROTOCOL
    # function pointers go dead post-EBS, but the framebuffer physical
    # base + geometry stay valid; we want stable values in boot_info
    # for the kernel's lifetime.
    rc = fncall3(fn_locate, &gop_guid, 0, &gop_out);
    if (rc == 0) {
        var gop_p    = load64(&gop_out);
        var gop_mode = load64(gop_p + 0x18);
        var cur_mode = load32(gop_mode + 0x04);  # Mode (UINT32) — current
        var max_mode = load32(gop_mode + 0x00);  # MaxMode (UINT32) — needed to gate the bounce

        # SetMode bounce before kernel handoff. Matches the convergent
        # prior-art shape (Linux efifb, EDK2 GraphicsConsoleDxe via Blt,
        # FreeBSD framebuffer.c, Limine) where SetMode flips firmware-
        # left scanout to a known state before direct CPU writes are
        # trusted. On AMD Zen UEFI both same-mode and different-mode
        # bounce forms are firmware-elided as no-ops — see CHANGELOG
        # 0.4.1 + 0.4.2 falsification notes — but the call is kept
        # because (a) it works on non-Zen firmware per the prior art,
        # (b) it's harmless when elided, and (c) gnoboot's role is to
        # match the convergent loader shape, not to fix per-vendor
        # scanout quirks (kernel-side responsibility per memory pin
        # `project_amd_zen_scanout_residue`).
        #
        # Bounce target: mode 0 (or mode 1 if cur_mode==0). Single-mode
        # firmware (max_mode <= 1) skips the bounce step. Both SetMode
        # return values are ignored: any failure to enter bounce_mode
        # still gets followed by SetMode(cur_mode), so the final state
        # is cur_mode either way, and the post-SetMode geometry re-read
        # below captures whatever's live in boot_info truthfully.
        var fn_setmode = load64(gop_p + 0x08);
        var bounce_mode = 0;
        if (cur_mode == 0) { bounce_mode = 1; }
        if (max_mode > 1) {
            fncall2(fn_setmode, gop_p, bounce_mode);
        }
        fncall2(fn_setmode, gop_p, cur_mode);

        # === NATIVE-RESOLUTION MODE SELECTION (0.6.1) ==========================================
        # Until now gnoboot restored whatever mode the firmware left, which on archaemenid is
        # 800x600 while the panel link trains at 2560x1440 — so the desktop rendered into the
        # upper-left eighth of the screen. Every other convergent loader (Limine, systemd-boot,
        # GRUB gfxmode, Linux efifb) picks a mode rather than inheriting one; this matches that
        # shape. QueryMode is vtable offset 0x00:
        #   EFI_STATUS QueryMode(This, ModeNumber, UINTN *SizeOfInfo, EFI_..._INFORMATION **Info)
        # Selection: largest width*height whose PixelFormat is 0 (RGB) or 1 (BGR). Formats 2
        # (BitMask) and 3 (BltOnly) are REFUSED — the kernel writes the framebuffer directly and
        # BltOnly has no linear FB at all, so inheriting one would hand agnos a surface it cannot
        # draw into.
        # ⚠ FAIL-SAFE BY CONSTRUCTION: best_mode starts as cur_mode, so a firmware that returns
        # nothing usable leaves the boot exactly as it was before this block existed. A failed
        # SetMode is followed by a restore to cur_mode, and the geometry re-read below reports
        # whatever is actually live — never what was intended.
        var fn_querymode = load64(gop_p + 0x00);
        var qm_sz = 0;
        var qm_inf = 0;
        var best_mode = cur_mode;
        var best_px = 0;
        # v0.7.0 (audit F9): bound the enumeration. MaxMode is a firmware
        # u32 and load32 zero-extends (verified empirically), so a
        # firmware reporting 0xFFFFFFFF would have spun ~4e9 QueryMode
        # calls pre-EBS with no way out. The ACPI config-table walk below
        # has capped its count at 256 since v0.5.0; this is the same
        # treatment for the other firmware-supplied count. `max_mode`
        # itself stays untouched so boot_info+0x64 keeps reporting what
        # the firmware actually claimed.
        var qm_n = max_mode;
        if (qm_n > 256) { qm_n = 256; }
        var mi = 0;
        while (mi < qm_n) {
            qm_sz = 0;
            qm_inf = 0;
            if (fncall4(fn_querymode, gop_p, mi, &qm_sz, &qm_inf) == 0) {
                if (qm_inf != 0) {
                    var q_pf = load32(qm_inf + 0x0C);
                    var ok = 0;
                    if (q_pf == 0) { ok = 1; }
                    if (q_pf == 1) { ok = 1; }
                    if (ok == 1) {
                        var q_w = load32(qm_inf + 0x04);
                        var q_h = load32(qm_inf + 0x08);
                        var q_px = q_w * q_h;
                        if (q_px > best_px) {
                            best_px = q_px;
                            best_mode = mi;
                        }
                    }
                }
            }
            mi = mi + 1;
        }
        if (best_mode != cur_mode) {
            if (fncall2(fn_setmode, gop_p, best_mode) != 0) {
                fncall2(fn_setmode, gop_p, cur_mode);   # refused — put it back exactly as found
            }
        }
        # Record what was CHOSEN vs what the firmware booted with, so a burn can tell "no better
        # mode existed" from "a better mode existed and SetMode refused it". The geometry captured
        # below is the ground truth either way.
        # 0x78, NOT 0x6C: 0x6C is inside fb_size's u64 at 0x68 and this store
        # was being destroyed by it (erratum E1). Relocated at v0.7.1.
        store32(&boot_info + 0x78, best_mode);

        # Re-read fields AFTER SetMode — firmware is spec-allowed to
        # reallocate the FB BAR + relocate Mode->Info on SetMode, so
        # post-SetMode values are the authoritative ones for handoff.
        var mode_inf = load64(gop_mode + 0x08);
        var fb_phys  = load64(gop_mode + 0x18);
        var fb_size  = load64(gop_mode + 0x20);  # FrameBufferSize (UEFI 2.10 §11.9.1)
        var fb_w     = load32(mode_inf + 0x04);
        var fb_h     = load32(mode_inf + 0x08);
        var pf       = load32(mode_inf + 0x0C);
        var ppl      = load32(mode_inf + 0x20);
        store64(&boot_info + 0x48, fb_phys);
        store32(&boot_info + 0x50, ppl * 4);   # fb_pitch (assume 32 bpp)
        store32(&boot_info + 0x54, fb_w);
        store32(&boot_info + 0x58, fb_h);
        store32(&boot_info + 0x5C, pf);
        store32(&boot_info + 0x60, cur_mode);  # GOP mode # firmware booted
        store32(&boot_info + 0x64, max_mode);  # GOP mode count available
        store64(&boot_info + 0x68, fb_size);   # FrameBufferSize
        # OR, not a bare store: bit 2 (kaslr_no_entropy) may already be
        # set by the KASLR step above, and a bare store would silently
        # clear it. The old code got away with it only because nothing
        # else wrote flags.
        store32(&boot_info + 0x0C, load32(&boot_info + 0x0C) | 0x02);   # flags.fb_present = 1
    }

    # --- 10d-f: Optional boot_info feature-fills (v0.5.0) --------------
    # All OPTIONAL + benign-on-failure (GOP-style): a missing ESP file or
    # absent ACPI table leaves the field 0 and the boot proceeds. They run
    # pre-EBS (file I/O + AllocatePages are Boot Services) and BEFORE the
    # Step-11/12 GetMemoryMap pair, so blob allocations land in the memory
    # map the kernel inherits. Stash root / Open / AllocatePages for the
    # 2-param load_esp_blob helper.
    store64(&g_root,     root);
    store64(&g_fn_open,  fn_open);
    store64(&g_fn_alloc, fn_alloc);

    # 10d: initramfs (P1 — ISO live-.iso gate). \boot\initramfs (format-
    #      neutral) → EfiLoaderData region; fill initramfs_phys (0x10) +
    #      size (0x18).
    #      gnoboot deliberately leads its consumer: the kernel reader
    #      (agnos core/initrd.cyr) currently mounts a synthetic INDR image
    #      from a fixed 0x6000 and does not yet read these fields — wiring
    #      that (and the cpio.gz-vs-INDR format contract) is a separate
    #      agnos-side follow-on. gnoboot's job here is faithful load+report.
    var ird = load_esp_blob(&path_initramfs, &initramfs_size_v);
    if (ird != 0) {
        store64(&boot_info + 0x10, ird);
        store64(&boot_info + 0x18, load64(&initramfs_size_v));
    }

    # 10e: kernel cmdline. \boot\cmdline (NUL-terminated UTF-8) →
    #      EfiLoaderData page; fill cmdline_phys (0x20). No kernel consumer
    #      yet — forward-compat field; loaded faithfully, NUL-termination
    #      is the build's responsibility (roadmap convention).
    var cmd = load_esp_blob(&path_cmdline, &cmdline_size_v);
    if (cmd != 0) {
        store64(&boot_info + 0x20, cmd);
    }

    # 10f: ACPI RSDP from the EFI Configuration Table (pure SystemTable
    #      reads — no Boot Service, so map-key-safe). ST->NumberOfTableEntries
    #      @ st+0x68, ST->ConfigurationTable @ st+0x70; each entry is
    #      {EFI_GUID[16], VendorTable[8]} = 24 B. Prefer the ACPI 2.0 GUID,
    #      fall back to 1.0; VendorTable IS the RSDP physical address →
    #      fill acpi_rsdp_phys (0x38). Unblocks ACPI under UEFI, where the
    #      kernel's legacy EBDA / 0xE0000 ROM scan finds nothing.
    var nents  = load64(st + 0x68);
    var ctab   = load64(st + 0x70);
    if (nents > 256) { nents = 256; }                # bound a malformed count
    if (nents < 0)   { nents = 0; }                  # u64 > i64 max — treat as absent
    if (ctab == 0)   { nents = 0; }                  # v0.7.0 (audit F9): null table with a
                                                     # non-zero count would walk from address 0
    var rsdp   = 0;
    var rsdp10 = 0;
    var ti = 0;
    while (ti < nents) {
        var ent = ctab + ti * 24;
        if (guid_eq(ent, &acpi20_guid) != 0) { rsdp   = load64(ent + 16); }
        if (guid_eq(ent, &acpi10_guid) != 0) { rsdp10 = load64(ent + 16); }
        ti = ti + 1;
    }
    if (rsdp == 0) { rsdp = rsdp10; }                # no 2.0 → use 1.0
    if (rsdp != 0) { store64(&boot_info + 0x38, rsdp); }

    # --- 11: Initial GetMemoryMap (informational; just to size the buffer) ---
    store64(&mm_size, 16384);
    rc = fncall5(fn_mmap, &mm_size, &mm_buf, &mm_key, &mm_dsz, &mm_dver);
    if (rc != 0) { efi_fail(st, &code_mm); return 0; }

    # --- Announce we're about to hand off (last text from gnoboot) ---
    # ClearScreen first so the banner lands on a fresh framebuffer
    # instead of trailing firmware/OVMF preamble. Cursor homes to (0,0).
    efi_clear(st);
    efi_print(st, &msg_pre);

    # --- Fill sovereign boot-info dynamic fields ---
    store64(&boot_info + 0x40, st);                    # efi_st_phys
    store64(&boot_info + 0x28, &mm_buf);               # memmap_phys

    # --- 12: Refresh GetMemoryMap RIGHT BEFORE ExitBootServices. Any
    #         firmware service called between GetMemoryMap and EBS may
    #         invalidate the key (allocator state changed). efi_print
    #         above almost certainly did. The fresh call returns a valid
    #         mm_key for the EBS that follows. No firmware service may
    #         be called between this point and the EBS call below. ---
    store64(&mm_size, 16384);
    rc = fncall5(fn_mmap, &mm_size, &mm_buf, &mm_key, &mm_dsz, &mm_dver);
    if (rc != 0) { efi_fail(st, &code_mm); return 0; }

    var sz  = load64(&mm_size);
    var dsz = load64(&mm_dsz);
    # v0.7.0 (audit F9): DescriptorSize is firmware-supplied and divides
    # sz on the next line. Zero would fault here — pre-EBS, so failing
    # loud at "MM" is both possible and correct.
    if (dsz < 1) { efi_fail(st, &code_mm); return 0; }
    store32(&boot_info + 0x30, sz / dsz);              # memmap_count
    store32(&boot_info + 0x34, dsz);                   # memmap_entsize

    # --- 13: ExitBootServices — POINT OF NO RETURN ---
    var key = load64(&mm_key);
    rc = fncall2(fn_ebs, handle, key);
    if (rc != 0) {
        # Map key invalidated between GetMemoryMap and here. We can still
        # try to print (firmware boot services likely partially alive) but
        # don't trust further calls.
        efi_fail(st, &code_ebs);
        return 0;
    }

    # --- Jump to kernel entry at 0x1000A8 with RDI = &boot_info ---
    # Cyrius's `var p = &boot_info` emits `movabs rax, &boot_info` —
    # leaves &boot_info in RAX for the asm below.
    var p = &boot_info;
    asm {
        # mov rdi, rax     ; rdi = &boot_info (sovereign-struct ptr) — set FIRST, persists in rdi
        0x48; 0x89; 0xC7;
    }
    # rax = kernel_jump_target (load_base + e_entry for PIE; absolute e_entry for ET_EXEC). It is a
    # stack local, so this load is `mov rax, [rbp-N]` — touches rax only, leaving rdi (= &boot_info)
    # intact. (Verified by objdump of the emitted .text; see KASLR bite 2a.)
    var jt = kernel_jump_target;
    asm {
        # jmp rax
        0xFF; 0xE0;
    }
    # Unreachable — kernel never returns to gnoboot.
    return 0;
}
