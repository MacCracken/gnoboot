# gnoboot — Step 4a probe (minimal): test cyrius global capture +
# firmware-RDX survival across cyrius prep code.
#
# Tests two things:
#   (1) `var p = &system_table;` at top level of kernel; mode
#       loads &system_table into RAX (per the agnos Path A shim's
#       mb_info_ptr capture pattern), with the address resolved
#       via a DIR64 base relocation (cyrius 5.11.49 emits .reloc
#       under CYRIUS_TARGET_EFI=1).
#   (2) Firmware's RDX (SystemTable*) survives cyrius's prologue +
#       the `var p = &foo` statement, so we can stash it into the
#       global with raw `mov [rax], rdx`.
#
# Banner emission stays inline-asm (same shape as Step 3) so the only
# new mechanism under test is the global-capture sequence at the top.
# If we see "step 4a probe ok" on ConOut, BOTH unknowns are resolved.
#
# Expected output on QEMU OVMF ConOut: "step 4a probe ok\r\n"

kernel;

# Uninitialized — no EMIT_GVAR_INITS, no register clobber at startup.
# Stores the SystemTable* pointer captured from firmware's RDX.
var system_table[8];

# Cyrius emits: lea rax, [rip + DIR64_reloc_to_system_table]
# Side-effect: RAX = &system_table, RDX preserved (only RAX touched).
var p = &system_table;
asm {
    # mov [rax], rdx   ; stash SystemTable* into the global
    0x48; 0x89; 0x10;
}

# At this point: system_table global holds SystemTable*, RDX still
# holds SystemTable* (we didn't clobber it). RCX may or may not still
# hold ImageHandle — irrelevant for the print, we walk via RDX.
asm {
    # mov rcx, [rdx + 0x40]   ; ConOut = SystemTable->ConOut
    0x48; 0x8B; 0x4A; 0x40;
    # mov rax, [rcx + 0x08]   ; OutputString fn ptr
    0x48; 0x8B; 0x41; 0x08;
    # lea rdx, [rip + 0x0E]   ; rdx = &banner (14 bytes after end-of-LEA)
    0x48; 0x8D; 0x15; 0x0E; 0x00; 0x00; 0x00;
    # sub rsp, 0x28           ; MS x64 shadow + 16-byte align
    0x48; 0x83; 0xEC; 0x28;
    # call rax                ; OutputString(rcx=ConOut, rdx=banner)
    0xFF; 0xD0;
    # add rsp, 0x28
    0x48; 0x83; 0xC4; 0x28;
    # xor eax, eax            ; EFI_SUCCESS
    0x31; 0xC0;
    # ret                     ; back to firmware
    0xC3;
    # nop (align banner to 2-byte CHAR16)
    0x90;
    # banner: UTF-16LE "step 4a probe ok\r\n\0" (36 bytes, 18 CHAR16 units)
    0x73; 0x00;   # 's'
    0x74; 0x00;   # 't'
    0x65; 0x00;   # 'e'
    0x70; 0x00;   # 'p'
    0x20; 0x00;   # ' '
    0x34; 0x00;   # '4'
    0x61; 0x00;   # 'a'
    0x20; 0x00;   # ' '
    0x70; 0x00;   # 'p'
    0x72; 0x00;   # 'r'
    0x6F; 0x00;   # 'o'
    0x62; 0x00;   # 'b'
    0x65; 0x00;   # 'e'
    0x20; 0x00;   # ' '
    0x6F; 0x00;   # 'o'
    0x6B; 0x00;   # 'k'
    0x0D; 0x00;   # '\r'
    0x0A; 0x00;   # '\n'
    0x00; 0x00;   # '\0' terminator
}
