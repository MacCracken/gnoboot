# gnoboot Step 4 — fn-based architecture, verified.
#
# Entry trampoline pattern (proven on QEMU OVMF 2026-05-13):
#   asm { mov r14, rcx; mov r15, rdx }   ; capture firmware args to callee-saved
#   var fp = &efi_main;                   ; cyrius: rax = &efi_main
#   asm { mov rcx, r14; mov rdx, r15; call rax }   ; MS x64 call into the fn
#
# *Cyrius's internal fn-call ABI under CYRIUS_TARGET_EFI is MS x64*,
# not SysV (verified via objdump — callee's prologue stores rcx/rdx,
# not rdi/rsi). This contradicts the lib/fnptr.cyr comment which
# documents SysV — surfaced upstream in
# cyrius/docs/development/issues/2026-05-13-gnoboot-efi-main-convention.md.
#
# The trampoline could be folded into cyrius itself if/when the
# `fn efi_main(handle, st)` convention proposal lands; until then we
# carry the ~15 lines of asm here.
#
# Expected ConOut output on success: "fn entry works"

kernel;

# UTF-16LE buffer — populated by top-level store8 calls below
var msg[34];

# Marshal globals for the firmware-call trampoline inside print_msg
var marshal_a0[8];
var marshal_fp[8];


# === fn body ============================================================

fn print_msg(handle, st) {
    # SysV ABI on the way in: rdi = handle, rsi = st (after the top-level
    # asm's translation from MS x64).
    var con_out = load64(st + 0x40);
    var out_str = load64(con_out + 0x08);

    # The agnos-shim pattern (var p = &g; asm { mov [rax], ... }) is
    # documented to work INSIDE a fn body — let's exercise it.
    store64(&marshal_a0, con_out);
    store64(&marshal_fp, out_str);

    var pmsg = &msg;
    asm {
        # rax = &msg (from the cyrius lea above). Move to rdx for MS x64 arg 1.
        0x48; 0x89; 0xC2;          # mov rdx, rax
    }

    var pa0 = &marshal_a0;
    asm {
        # rax = &marshal_a0. Load *rax = con_out into rcx (MS x64 arg 0).
        0x48; 0x8B; 0x08;          # mov rcx, [rax]
    }

    var pfp = &marshal_fp;
    asm {
        # rax = &marshal_fp. Load *rax = out_str into rax (call target).
        0x48; 0x8B; 0x00;          # mov rax, [rax]
        # sub rsp, 0x28; call rax; add rsp, 0x28  (MS x64 shadow + align)
        0x48; 0x83; 0xEC; 0x28;
        0xFF; 0xD0;
        0x48; 0x83; 0xC4; 0x28;
    }
    return 0;
}


# === Top-level entry ====================================================

# Build msg = UTF-16LE "fn entry works\r\n\0" (32 bytes data + 2 NUL = 34)
store8(&msg +  0, 0x66); store8(&msg +  1, 0x00);  # f
store8(&msg +  2, 0x6E); store8(&msg +  3, 0x00);  # n
store8(&msg +  4, 0x20); store8(&msg +  5, 0x00);  # SP
store8(&msg +  6, 0x65); store8(&msg +  7, 0x00);  # e
store8(&msg +  8, 0x6E); store8(&msg +  9, 0x00);  # n
store8(&msg + 10, 0x74); store8(&msg + 11, 0x00);  # t
store8(&msg + 12, 0x72); store8(&msg + 13, 0x00);  # r
store8(&msg + 14, 0x79); store8(&msg + 15, 0x00);  # y
store8(&msg + 16, 0x20); store8(&msg + 17, 0x00);  # SP
store8(&msg + 18, 0x77); store8(&msg + 19, 0x00);  # w
store8(&msg + 20, 0x6F); store8(&msg + 21, 0x00);  # o
store8(&msg + 22, 0x72); store8(&msg + 23, 0x00);  # r
store8(&msg + 24, 0x6B); store8(&msg + 25, 0x00);  # k
store8(&msg + 26, 0x73); store8(&msg + 27, 0x00);  # s
store8(&msg + 28, 0x0D); store8(&msg + 29, 0x00);  # \r
store8(&msg + 30, 0x0A); store8(&msg + 31, 0x00);  # \n

# Capture firmware args to callee-saved regs (preserved across cyrius
# internal calls in BOTH SysV and MS x64).
asm {
    # mov r14, rcx     ; ImageHandle
    0x49; 0x89; 0xCE;
    # mov r15, rdx     ; SystemTable*
    0x49; 0x89; 0xD7;
}

# Get the cyrius fn pointer. Under the observed kmode emit-order, the
# `var p = &foo;` init code emits *between* this statement and the next
# asm block — so the next asm starts with `rax = &print_msg`.
var fp = &print_msg;

# Pass firmware args to print_msg using MS x64 ABI (cyrius's internal
# call convention under CYRIUS_TARGET_EFI; see file header).
asm {
    # mov rcx, r14   ; arg 0 = ImageHandle
    0x4C; 0x89; 0xF1;
    # mov rdx, r15   ; arg 1 = SystemTable*
    0x4C; 0x89; 0xFA;
    # The entry into our binary was via `call` (firmware pushed a return
    # address). After two `mov`s rsp is still 8 mod 16. We need 0 mod 16
    # before our internal `call rax`, so sub rsp, 8.
    0x48; 0x83; 0xEC; 0x08;
    # call rax    ; print_msg(rcx=ImageHandle, rdx=SystemTable)
    0xFF; 0xD0;
    # add rsp, 8
    0x48; 0x83; 0xC4; 0x08;
    # xor eax, eax        ; EFI_SUCCESS
    0x31; 0xC0;
    # ret                 ; back to firmware
    0xC3;
}
